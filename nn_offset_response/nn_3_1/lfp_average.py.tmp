import os
import sys

sys.path.insert(1, os.path.dirname(os.getcwd()))

import numpy as np
import h5py
from tools import nn_tool as nt
from parameters import parameters as pm
import matplotlib.pyplot as plt
import pickle
import quantities as pq
import pylustrator
import statsmodels.stats.api as sms
from tools import nn_tool as nt

pylustrator.start()
# I'm going to use only 70 dB here

file = "/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021/data" \
       "/dataset/nn_layer/nn_layer_nn_3_1.hdf5"

dbs = ['70', '60']
db = [0, 1]
val = pm.Setup(cond2='tsp')
cb = val.values()[-2]
dcmap = val.values()[7]
names = ['nn_3_1', 'nn_wn_3_1']
legends = ['NN - OFF', 'WN - OFF']
ch_l = [0, 7, 11]  # channel number
depth = [100, 800, 1200]
l_list = ['supr', 'gran', 'infr']  # list of layers
layer_name = ['Supragranular\nLayer', 'Granular\nLayer',
              'Infragranular\nLayer']
g_lf = {}  # dict to store lfp
g_cf = {}  # dict for quartile

# time index for lfp
tl = nt.lfp_index(3000)
th = nt.lfp_index(3101)

with h5py.File(file, 'r') as h_5:
    data = h_5['lfp']['70']
    for n in names:
        g_lf[n] = []
        g_cf[n] = []
        for layer in l_list:
            tems = np.median(data[n][layer], axis=0)  # average spk
            temc2 = np.percentile(data[n][layer], 25, axis=0)
            temc7 = np.percentile(data[n][layer], 75, axis=0)
            t_min = np.min(tems[tl:th])  # peak value
            # ind of offset peak
            t_ind = [
                x for x in np.where(tems == t_min)[0] if tl < x < th
                ][0]

            t_ic = [temc2[t_ind], temc7[t_ind]]

            g_lf[n].append(t_min)
            g_cf[n].append(t_ic)

# plot
s_fig = plt.figure(figsize=(9, 9))
nx = np.arange(3)
width = 0.35

nn = plt.bar(
    nx - width / 2, g_lf[names[0]], width,
    label=legends[0], color=dcmap[0])
wn = plt.bar(
    nx + width / 2, g_lf[names[1]], width,
    label=legends[1], color=dcmap[1])

plt.legend(prop={'size': 15},
           loc='lower left',
           bbox_to_anchor=(0, 0))

# for i in nx:
