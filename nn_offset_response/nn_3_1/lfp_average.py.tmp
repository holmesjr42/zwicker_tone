#                                                 g_cf[names[0]][i][1]], 'k')
#
#     plt.plot([nx + width / 2, nx + width / 2], [g_cf[names[1]][i][0],
#                                                 g_cf[names[1]][i][1]], 'k')

plt.xticks(nx, layer_name, size=15, weight='bold')
plt.yticks(size=15)
plt.text(0, 0, 'Amplitude (mV)', size=20, weight='bold',
         horizontalalignment='center', verticalalignment='center',
         rotation='vertical')

