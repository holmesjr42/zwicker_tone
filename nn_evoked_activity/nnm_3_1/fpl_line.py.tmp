import os
import sys

print(os.path.dirname(os.getcwd()))
sys.path.insert(1, os.path.dirname(os.getcwd()))
import numpy as np
import matplotlib.pyplot as plt
from parameters import parameters as pm
import h5py
from matplotlib.colors import ListedColormap
from tools import nnm_plot as nnmp
import pylustrator
import quantities as pq
from tools import nn_tool as nt

pylustrator.start()
sys.path.pop(1)

'''
Create heatmap for firing rate
'''

# import features
nnc = pm.Nnmcontfeat
nns = pm.Nnsifeat
com = pm.Commonfeat

# some setups for plotting e.g. color scheme
val = pm.Setup(cond='nnm_3_0', cond2='tsp', mode=1)
mode, ylc, condc, condt, nb, ch, depth, dcmap, ws, hs, rt, cct, cb, ccmap = \
    val.values()
sets = val.extra_setup()
lvl = com.db['lv']  # SPLdB list

file_input = '/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021' \
             '/data/dataset/nnm_spk_lfp_avg/all_spk_lfp_avg_nnm.hdf5'
# file_input = snakemake.input[0]

# stimulus conditions for this script
c_n = sets[-8][1]
c_w = sets[-6][0]
c_c = sets[-7][1]
paradigm = sets[6]
l_n = sets[1]
# list of layer names
layer_name = sets[0]

lfp = {}  # dict for spk data regarding dBSPL

# load file
with h5py.File(file_input, 'r') as dat:
    lp = [dat['fpl'][c_c], dat['fpl'][c_n], dat['fpl'][c_w]]  # spk

    for i in lvl:
        lfp[i] = [np.array(lp[0][i]), np.array(lp[1][i][0]),
                  np.array(lp[1][i][1]), np.array(lp[2][i][1])] * pq.microvolt
        lfp[i].units = pq.mV

lvp = nnmp.db_lv(lfp)  # SPL dB which actually has data

# average it as infra/granule/supragranule layer

s_ave = {}

for i in lvp:
    con = []
    for j in range(len(lfp[i])):
        con.append(nt.layer_average(lfp[i][j], l_n))
    s_ave[i] = con

# plot start
s_img = []  # for normalizing heatmap

s_fig = plt.figure(0, figsize=(16, 9))

s_axs = s_fig.subplots(3, 4)


for i in range(len(lvp)):
    data = s_ave[lvp[i]]
    # pv = p[lvp[i]]
    for j in range(len(data[0])):
        s_axs[j, i].axvspan(-1, 1, alpha=0.3, color='#bccbe3')

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[0][j], label=paradigm[0],
                         color=dcmap[0], linestyle='-', linewidth=2
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[1][j], label=paradigm[1],
                         color=dcmap[1], linestyle='--', linewidth=2
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[2][j], label=paradigm[2],
                         color=dcmap[2], linestyle='-.', linewidth=2
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[3][j], label=paradigm[3],
                         color=dcmap[4], linestyle=(0, (1, 1)), linewidth=2
                         )

        s_axs[j, i].set_xticks([-1.5, -1, 0, 1, 1.5])

        if j == 0:
            s_axs[j, i].set_yticks(np.arange(-0.2, 0.001, 0.04))
            s_axs[j, i].set_ylim([-0.22, 0.01])
        elif j == 1:
            s_axs[j, i].set_yticks(np.arange(-0.25, 0.01, 0.05))
            s_axs[j, i].set_ylim([-0.255, 0.01])
        elif j == 2:
            s_axs[j, i].set_yticks(np.arange(-0.1, 0.001, 0.02))
            s_axs[j, i].set_ylim([-0.115, 0.005])

        s_axs[j, i].set_xlim([-1.5, 1.5])
        s_axs[j, i].tick_params(axis='both', which='major', labelsize=13)
        s_axs[j, i].label_outer()

        if j == 0:
            s_axs[j, i].text(0, 0, f'{lvp[i]} dB',
                             horizontalalignment='center',
                             verticalalignment='center',
                             # rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'weight': 'bold', 'size': 25}
                             )

        if i == 0:
            s_axs[j, i].text(0, 0, layer_name[j],
                             horizontalalignment='center',
                             verticalalignment='center',
                             rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'size': 15}
                             )

s_axs[0, 3].legend(prop={'size': 11},
                   loc='lower left',
                   bbox_to_anchor=(0, 0))

s_axs[1, 2].text(0, 0, 'octaves',
                 horizontalalignment='center',
                 verticalalignment='center',
                 # rotation='vertical',
                 transform=s_axs[1, 2].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )

s_axs[0, 0].text(0, 0, 'Amplitude (mV)',
                 horizontalalignment='center',
                 verticalalignment='center',
                 rotation='vertical',
                 transform=s_axs[1, 3].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )

