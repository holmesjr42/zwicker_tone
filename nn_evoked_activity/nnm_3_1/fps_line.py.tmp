import os
import sys

print(os.path.dirname(os.getcwd()))
sys.path.insert(1, os.path.dirname(os.getcwd()))
import numpy as np
import matplotlib.pyplot as plt
from parameters import parameters as pm
import h5py
from tools import nnm_plot as nnmp
import pylustrator
import quantities as pq
from tools import nn_tool as nt

pylustrator.start()
sys.path.pop(1)

'''
Create heatmap for firing rate
'''

# import features
nnc = pm.Nnmcontfeat
nns = pm.Nnsifeat
com = pm.Commonfeat

# some setups for plotting e.g. color scheme
val = pm.Setup(cond='nnm_3_0', cond2='tsp', mode=1)
mode, ylc, condc, condt, nb, ch, depth, dcmap, ws, hs, rt, cct, cb, ccmap = \
    val.values()
sets = val.extra_setup()
lvl = com.db['lv']  # SPLdB list

file_input = '/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021' \
             '/data/dataset/nnm_spk_lfp_avg/all_spk_lfp_avg_nnm.hdf5'
# file_input = snakemake.input[0]

# stimulus conditions for this script
c_n = sets[-8][1]
c_w = sets[-6][0]
c_c = sets[-7][1]
paradigm = sets[6]
l_n = sets[1]

# list of layer names
layer_name = sets[0]

spk = {}  # dict for spk data regarding dBSPL

# load file
with h5py.File(file_input, 'r') as dat:
    sk = [dat['fpt'][c_c], dat['fpt'][c_n], dat['fpt'][c_w]]  # spk

    for i in lvl:
        spk[i] = [np.array(sk[0][i]), np.array(sk[1][i][0]),
                  np.array(sk[1][i][1]), np.array(sk[2][i][1])] * (pq.ms ** -1)
        spk[i].units = pq.s ** (-1)

lvp = nnmp.db_lv(spk)  # SPL dB which actually has data

# average it as infra/granule/supragranule layer
s_ave = {}

for i in lvp:
    con = []
    for j in range(len(spk[i])):
        con.append(nt.layer_average(spk[i][j], l_n))

    s_ave[i] = con

# plot start
s_img = []  # for normalizing heatmap

s_fig = plt.figure(0, figsize=(16, 9))

s_axs = s_fig.subplots(3, 4)


for i in range(len(lvp)):
    data = s_ave[lvp[i]]
    # pv = p[lvp[i]]
    for j in range(len(data[0])):
        s_axs[j, i].axvspan(-1, 1, alpha=0.3, color='#bccbe3')

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[0][j], label='Control',
                         color=dcmap[0], linestyle='-', linewidth=2
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[1][j], label='NN-ON',
                         color=dcmap[1], linestyle='--', linewidth=2
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[2][j], label='NN-OFF',
                         color=dcmap[2], linestyle='-.', linewidth=2
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[3][j], label='WN-OFF',
                         color=dcmap[4], linestyle=(0, (1, 1)), linewidth=2
                         )

        s_axs[j, i].set_xticks([-1.5, -1, 0, 1, 1.5])

        # ticks
        if j == 0:
            s_axs[j, i].set_yticks(np.arange(0, 121, 40))
            s_axs[j, i].set_ylim([0, 120])
        elif j == 1:
            s_axs[j, i].set_yticks(np.arange(0, 201, 50))
            s_axs[j, i].set_ylim([0, 200])
        elif j == 2:
            s_axs[j, i].set_yticks(np.arange(0, 101, 20))
            s_axs[j, i].set_ylim([0, 110])

        s_axs[j, i].set_xlim([-1.5, 1.5])
        s_axs[j, i].tick_params(axis='both', which='major', labelsize=13)
        s_axs[j, i].label_outer()

        if j == 0:
            s_axs[j, i].text(0, 0, f'{lvp[i]} dB',
                             horizontalalignment='center',
                             verticalalignment='center',
                             # rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'weight': 'bold', 'size': 25}
                             )

        if i == 0:
            s_axs[j, i].text(0, 0, layer_name[j],
                             horizontalalignment='center',
                             verticalalignment='center',
                             rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'size': 15}
                             )

s_axs[0, 0].legend(prop={'size': 11},
                   loc='upper left',
                   bbox_to_anchor=(0, 1))

s_axs[1, 2].text(0, 0, 'octaves',
                 horizontalalignment='center',
                 verticalalignment='center',
                 # rotation='vertical',
                 transform=s_axs[1, 2].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )

s_axs[0, 0].text(0, 0, 'Firing rate (spk / s)',
                 horizontalalignment='center',
                 verticalalignment='center',
                 rotation='vertical',
                 transform=s_axs[1, 3].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )

#% start: automatic generated code from pylustrator
plt.figure(0).ax_dict = {ax.get_label(): ax for ax in plt.figure(0).axes}
import matplotlib as mpl
plt.figure(0).axes[0].texts[0].set_position([0.508226, 1.157865])
plt.figure(0).axes[0].texts[1].set_position([-0.485967, 0.559307])
plt.figure(0).axes[0].texts[2].set_position([-3.839516, 0.539683])
plt.figure(0).axes[1].texts[0].set_position([0.474839, 1.157865])
plt.figure(0).axes[2].texts[0].set_position([0.497097, 1.157865])
plt.figure(0).axes[3].texts[0].set_position([0.504516, 1.157865])
plt.figure(0).axes[4].texts[0].set_position([-0.485967, 0.495527])
plt.figure(0).axes[6].texts[0].set_position([-0.107581, -1.506205])
plt.figure(0).axes[8].texts[0].set_position([-0.485967, 0.534776])
