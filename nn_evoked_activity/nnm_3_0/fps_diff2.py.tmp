'''
Create heatmap for firing rate
'''

# import features
nnc = pm.Nnmcontfeat
nns = pm.Nnsifeat
com = pm.Commonfeat

# some setups for plotting e.g. color scheme
val = pm.Setup(cond='nnm_3_0', cond2='tsp', mode=1)
mode, ylc, condc, condt, nb, ch, depth, dcmap, ws, hs, rt, cct, cb, ccmap = \
    val.values()
lvl = com.db['lv']  # SPLdB list

file_input = '/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021' \
             '/data/dataset/fp_layer/fp_layer_nnm_3_0.hdf5'
# file_input = snakemake.input[0]

# stimulus conditions for this script
cn = 'nnm_3_0'
cs = 'nnm_3_0_strf'

layer_name = ['Supragranular\nLayer', 'Granular\nLayer',
              'Infragranular\nLayer']

l_list = ['supr', 'gran', 'infr']

spk = {}  # dict for spk data regarding SPLdB

# index of low edge, center, high edge, 0.5 oct above/below  of notch gap
mid = 12
lef = 4
hef = 20
hbe = 8
hab = 16
finx = [lef, mid, hef]
f_name = ['Low edge frq', 'Center frq', 'High edge Frq']
l_style = ['dashdot', '-', 'dashed']
ratio = {}
errb = {}
fps = {}
# load file
with h5py.File(file_input, 'r') as dat:
    sk = dat['fps']  # spk

    for layer in l_list:
        meann = []
        meanc = []
        errn = []
        errc = []
        for lv in lvl:
            tempn = np.mean(sk['nnm_3_0'][layer][lv], axis=0)
            tempc = np.mean(sk['nnm_3_0_strf'][layer][lv], axis=0)

            tempn2 = np.std(sk['nnm_3_0'][layer][lv], axis=0)
            tempc2 = np.std(sk['nnm_3_0_strf'][layer][lv], axis=0)

            meann.append(
                [tempn[finx[0]], tempn[finx[1]], tempn[finx[2]]]
                )
            meanc.append(
                [tempc[finx[0]], tempc[finx[1]], tempc[finx[2]]]
                )

            errn.append(
                [tempn2[finx[0]], tempn2[finx[1]], tempn2[finx[2]]]
                )
            errc.append(
                [tempc2[finx[0]], tempc2[finx[1]], tempc2[finx[2]]]
                )

        meann = np.transpose(meann)
        meanc = np.transpose(meanc)
        errn = np.transpose(errn)
        errc = np.transpose(errc)
        ratio[layer] = (meann - meanc) / meanc
        errb[layer] = (errn - errc) / errc

# plot start
s_img = []  # for normalizing heatmap

s_fig = plt.figure(0, figsize=(16, 9))

s_axs = s_fig.subplots(1, 3)
xs = np.arange(4)

# ticks
for j in range(len(l_list)):
    ls = l_list[j]
    for i in range(len(f_name)):
        ftext = f_name[i]
        s_axs[j].plot(xs, ratio[ls][i],
                      color=dcmap[i],
                      label=f_name[i],
                      lw=3,
                      linestyle=l_style[i], zorder=2)

        s_axs[j].fill_between(xs,
                      np.array(ratio[ls][i]) - 1 * np.array(errb[ls][i]),
                      np.array(ratio[ls][i]) + 1 * np.array(errb[ls][i]),
                      color=dcmap[i], zorder=2, alpha=0.2)

        s_axs[j].set_yticks(np.arange(-0.8, 1.2, 0.2))
        s_axs[j].set_ylim(-.9, 1.2)

# extra texts
for i in range(len(layer_name)):
    s_axs[i].text(0.5, 0, layer_name[i],
                  horizontalalignment='center',
                  verticalalignment='center',
                  # rotation='vertical',
                  transform=s_axs[i].transAxes,
                  fontdict={'weight': 'bold', 'size': 25}
                  )
#
    s_axs[i].set_xticks(np.arange(4))
    s_axs[i].set_xticklabels(['70', '60', '50', '40'])
    s_axs[i].tick_params(axis='both', which='major', labelsize=15)
    s_axs[i].axhline(y=0, c='k', lw=1.5, alpha=0.5, linestyle='dotted',
                     zorder=1)

s_axs[2].legend(prop={'size': 10},
                loc='lower left',
                bbox_to_anchor=(0, 0))

s_axs[0].text(0, 0.5, 'Ratio of changes\nto control',
              horizontalalignment='center',
              verticalalignment='center',
              rotation='vertical',
              transform=s_axs[0].transAxes,
              fontdict={'weight': 'bold', 'size': 25}
              )

s_axs[1].text(0.5, 0, 'dB SPL',
              horizontalalignment='center',
              verticalalignment='center',
              # rotation='vertical',
              transform=s_axs[1].transAxes,
              fontdict={'weight': 'bold', 'size': 25}
              )

