import os
import sys

print(os.path.dirname(os.getcwd()))
sys.path.insert(1, os.path.dirname(os.getcwd()))
import numpy as np
import pickle
import matplotlib.pyplot as plt
from parameters import parameters as pm
import h5py
import pylustrator
from tools import nn_tool as nt

pylustrator.start()
sys.path.pop(1)

'''
Create heatmap for firing rate
'''

# import features
nnc = pm.Nnmcontfeat
nns = pm.Nnsifeat
com = pm.Commonfeat

# some setups for plotting e.g. color scheme
val = pm.Setup(cond='nnm_3_0', cond2='lfp', mode=1)
mode, ylc, condc, condt, nb, ch, depth, dcmap, ws, hs, rt, cct, cb, ccmap = \
    val.values()
lvl = com.db['lv']  # SPLdB list
sets = val.extra_setup()

file_input = '/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021' \
             '/data/dataset/fp_layer/fp_layer_nnm_3_0.hdf5'
# file_input = snakemake.input[0]

# stimulus conditions for this script
cn = sets[7][0]
cs = sets[8][0]
layer_name = sets[0]
l_n = sets[1]
l_list = sets[2]
octs = com.octaves  # list of octaves
lfp = [[] for _ in range(3)]  # list for spk data regarding layers
stat = {}  # dict for stat regarding layers

# indice of edge frequencies in octaves
find = [sets[3][1], sets[3][-2]]

# load file
with h5py.File(file_input, 'r') as dat:
    lp = [dat['fpl'][cs], dat['fpl'][cn]]  # spk

    for l in range(len(l_list)):
        ly = l_list[l]
        stat[ly] = {}
        for lv in lvl:
            # list of the max/min spk/lfp frequency in nn band
            fm = []

            # stat[ly][lv] = []
            lfp[l].append([
                np.mean(lp[0][ly][lv], axis=0),
                np.mean(lp[1][ly][lv], axis=0)
                ])
            dt = lp[1][ly][lv]
            for a in range(len(dt)):
                fm.append(nt.freq_find(dt[a], find, type='lfp'))

            test = nt.fp_wilcoxon([lp[0][ly][lv], lp[1][ly][lv]], fm)
            stat[ly][lv] = test

            # for f in range(len(find)):
            #     test = nt.fp_wilcoxon([lp[0][ly][lv], lp[1][ly][lv]], find[f])
            #     stat[ly][lv].append(test)


# plot start
s_img = []  # for normalizing heatmap

s_fig = plt.figure(0, figsize=(16, 9))

s_axs = s_fig.subplots(3, 4)
lim_min = [-0.22, -0.22, -0.115]
lim_tick = [[-0.20, 0.001, 0.05], [-0.20, 0.001, 0.05], [-0.10, 0.005, 0.02]]
for j in range(len(l_list)):
    stat1 = stat[l_list[j]]
    for i in range(len(lvl)):
        stat2 = stat1[lvl[i]]
        data = lfp[j][i]

        s_axs[j, i].axvspan(-0.5, 0.5, alpha=0.3, color='#bccbe3')

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[0], label='Control',
                         color=dcmap[0], linestyle='-', linewidth=3
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[1], label='NN',
                         color=dcmap[1], linestyle='--', linewidth=3
                         )

        s_axs[j, i].set_xticks([-1.5, -1., -0.5, 0., 0.5, 1., 1.5], minor=True)
        s_axs[j, i].set_xticks([-1., 0., 1.])
        s_axs[j, i].set_xlim([-1.5, 1.5])
        # for k in range(len(find)):
        #     if stat2[k][1] < 0.05:
        #         x = np.int(stat2[k][0])
        #         s_axs[j, i].scatter(octs[x],
        #                             np.min([data[0][x], data[1][x]]) +
        #         lim_min[j] * 0.1,
        #                             marker=(5, 2), color="k"
        #                             )
        #     else:
        #         pass

        if stat2[1] < 0.05:
            x = np.int(stat2[0])
            s_axs[j, i].scatter(octs[x],
                                np.max([data[0][x], data[1][x]]) -
                                lim_tick[j][2],
                                marker=(5, 2), color="k"
                                )
        else:
            pass

        s_axs[j, i].set_ylim([lim_min[j], 0.01])
        s_axs[j, i].set_yticks(np.arange(
            lim_tick[j][0], lim_tick[j][1], lim_tick[j][2]
            ))

        s_axs[j, i].tick_params(axis='both', which='major', labelsize=15)
        s_axs[j, i].label_outer()

        if j == 0:
            s_axs[j, i].text(0, 0, f'{lvl[i]} dB',
                             horizontalalignment='center',
                             verticalalignment='center',
                             # rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'weight': 'bold', 'size': 25}
                             )

        if i == 0:
            s_axs[j, i].text(0, 0, layer_name[j],
                             horizontalalignment='center',
                             verticalalignment='center',
                             rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'size': 15}
                             )

s_axs[0, 3].legend(prop={'size': 12},
                   loc='lower left',
                   bbox_to_anchor=(0, 0))

s_axs[1, 2].text(0, 0, 'octaves',
                 horizontalalignment='center',
                 verticalalignment='center',
                 # rotation='vertical',
                 transform=s_axs[1, 2].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )

s_axs[0, 0].text(0, 0, 'Amplitude (mV)',
                 horizontalalignment='center',
                 verticalalignment='center',
                 rotation='vertical',
                 transform=s_axs[1, 3].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )
