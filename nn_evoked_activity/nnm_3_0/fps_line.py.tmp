import os
import sys

print(os.path.dirname(os.getcwd()))
sys.path.insert(1, os.path.dirname(os.getcwd()))
import numpy as np
import pickle
import matplotlib.pyplot as plt
from parameters import parameters as pm
import h5py
from tools import nnm_plot as nnmp
import pylustrator
import quantities as pq
from tools import nn_tool as nt

pylustrator.start()
sys.path.pop(1)

'''
Create heatmap for firing rate
'''

# import features
nnc = pm.Nnmcontfeat
nns = pm.Nnsifeat
com = pm.Commonfeat

# some setups for plotting e.g. color scheme
val = pm.Setup(cond='nnm_3_0', cond2='tsp', mode=1)
mode, ylc, condc, condt, nb, ch, depth, dcmap, ws, hs, rt, cct, cb, ccmap = \
    val.values()
lvl = com.db['lv']  # SPLdB list
sets = val.extra_setup()

file_input = '/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021' \
             '/data/dataset/nnm_spk_lfp_avg/all_spk_lfp_avg_nnm.hdf5'
# file_input = snakemake.input[0]

# stimulus conditions for this script
cn = sets[7][0]
cs = sets[8][0]
layer_name = sets[0]
l_n = sets[1]
spk = {}  # dict for spk data regarding dBSPL

# load file
with h5py.File(file_input, 'r') as dat:
    sk = [dat['fpt'][cs], dat['fpt'][cn]]  # spk

    for i in lvl:
        spk[i] = [np.array(sk[0][i]), np.array(sk[1][i])] * pq.ms**(-1)
        spk[i].units = pq.s**(-1)

lvp = nnmp.db_lv(spk)  # SPL dB which actually has data


# average it as infra/granule/supragranule layer
s_ave = {}

for i in lvp:
    con = []
    for j in range(len(spk[i])):
        con.append(nt.layer_average(spk[i][j], l_n))

    s_ave[i] = con

# loading p-value
# with open('/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021/data'
#           '/dataset/wilcoxon/nnm_3_0_wilcoxon_layer.pk', 'rb') as datas:
#     p = pickle.load(datas)['w_spk']

# plot start
s_img = []  # for normalizing heatmap

s_fig = plt.figure(0, figsize=(16, 9))

s_axs = s_fig.subplots(3, 4)

for i in range(len(lvp)):
    data = s_ave[lvp[i]]
    # pv = p[lvp[i]]
    for j in range(len(data[0])):
        s_axs[j, i].tick_params(axis='both', which='major',
                                labelsize=15, length=6, width=1.5)
        s_axs[j, i].axvspan(-1, 1, alpha=0.3, color='#bccbe3')

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[0][j], label='Control',
                         color=dcmap[0], linestyle='-', linewidth=3
                         )

        s_axs[j, i].plot(np.linspace(-1.5, 1.5, 25, endpoint=True),
                         data[1][j], label='NN',
                         color=dcmap[1], linestyle='--', linewidth=3
                         )

        s_axs[j, i].set_xticks([-1.5, -1, 0, 1, 1.5])
        s_axs[j, i].set_xlim([-1.5, 1.5])

        # p-value asterisk
        # if pv[j] < 0.05:
        #     s_axs[j, i].scatter(0, data[1][j][12] * 1.05,
        #                         marker=(5, 2), c='black', alpha=0.7)

        if j == 0:
            s_axs[j, i].set_yticks(np.arange(0, 61, 20))
            s_axs[j, i].set_ylim([0, 65])
        elif j == 1:
            s_axs[j, i].set_yticks(np.arange(0, 161, 40))
            s_axs[j, i].set_ylim([0, 160])
        elif j == 2:
            s_axs[j, i].set_yticks(np.arange(0, 81, 20))
            s_axs[j, i].set_ylim([0, 85])

        if i != 0:
            s_axs[j, i].set_yticks([])
        if j != 2:
            s_axs[j, i].set_xticks([])

        if j == 0:
            s_axs[j, i].text(0, 0, f'{lvp[i]} dB',
                             horizontalalignment='center',
                             verticalalignment='center',
                             # rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'weight': 'bold', 'size': 25}
                             )

        if i == 0:
            s_axs[j, i].text(0, 0, layer_name[j],
                             horizontalalignment='center',
                             verticalalignment='center',
                             rotation='vertical',
                             transform=s_axs[j, i].transAxes,
                             fontdict={'size': 17}
                             )

s_axs[0, 3].legend(prop={'size': 12},
                   loc='upper left',
                   bbox_to_anchor=(0, 1))

s_axs[1, 2].text(0, 0, 'octaves',
                 horizontalalignment='center',
                 verticalalignment='center',
                 # rotation='vertical',
                 transform=s_axs[1, 2].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )

s_axs[0, 0].text(0, 0, 'Firing rate (spk / s)',
                 horizontalalignment='center',
                 verticalalignment='center',
                 rotation='vertical',
                 transform=s_axs[1, 3].transAxes,
                 fontdict={'weight': 'bold', 'size': 23}
                 )
# s_axs[j, i].label_outer()
