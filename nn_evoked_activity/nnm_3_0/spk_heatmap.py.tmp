import matplotlib.image as mpimg
from parameters import parameters as pm
import seaborn as sns
import h5py
from matplotlib.colors import ListedColormap
from tools import nnm_plot as nnmp
import pylustrator

pylustrator.start()
sys.path.pop(1)

'''
Create heatmap for firing rate
'''

# import features
nnc = pm.Nnmcontfeat
nns = pm.Nnsifeat
com = pm.Commonfeat

# some setups for plotting e.g. color scheme
val = pm.Setup(cond='nnm_3_0', cond2='tsp', mode=1)
mode, ylc, condc, condt, nb, ch, depth, dcmap, ws, hs, rt, cct, cb, ccmap = \
    val.values()
lvl = com.db['lv']  # SPLdB list

file_input = '/home/bhc/OneDrive/Work/PhD/projects/zwicker_tone_2018_2021' \
             '/data/dataset/nnm_spk_lfp_avg/cr95_201117_spk_lfp_avg_nnm.hdf5'
# file_input = snakemake.input[0]

# getting animal cr number
animal = nnmp.animal_name(file_input)

# stimulus conditions for this script
c_n = 'nnm_3_0'
c_s = 'nnm_3_0_strf'
spk = {}  # dict for spk data regarding SPLdB

# load file
with h5py.File(file_input, 'r') as dat:
    sk = [dat['tsp'][c_s], dat['tsp'][c_n]]  # spk

    for i in lvl:
        spk[i] = [np.array(sk[0][i][9]), np.array(sk[1][i][9])]
lvp = nnmp.db_lv(spk)  # SPL dB which actually has data
print(lvp)
# plot start
s_img = []  # for normalizing heatmap

s_fig = plt.figure(0, figsize=(16, 9))

s_axs = s_fig.subplots(2, 4)

col = [0, 2, 0, 2]  # location of ctrl and nn column
row = [0, 0, 1, 1]  # location of each dB data
title = ['Control', 'NN']  # title of plots

for i in range(len(lvp)):
    data = spk[lvp[i]]
    axes = [s_axs[row[i], col[i]], s_axs[row[i], col[i] + 1]]
    nnmp.nnm_plot(axes[0], data[0], s_img, ccmap)
    nnmp.nnm_plot(axes[1], data[1], s_img, ccmap)
    axes[1].axes.yaxis.set_ticklabels([])

    if row[i] == 0:
        for j in axes:
            j.axes.xaxis.set_ticklabels([])

    # Plot title

    if row[i] == 0:
        for j in range(len(title)):
            axes[j].set_title(title[j], fontdict={'fontsize': 20})

    # SPL dB
    axes[0].text(0, 0, f'{lvp[i]} SPL dB',
                 horizontalalignment='center',
                 verticalalignment='center',
                 # rotation='vertical',
                 transform=axes[0].transAxes,
                 fontdict={'weight': 'bold', 'size': 25}
                 )

# unit text
s_axs[0, 0].text(0, 0, 'Octave',
                 horizontalalignment='center',
                 verticalalignment='center',
                 rotation='vertical',
                 transform=s_axs[0, 0].transAxes,
                 fontdict={'weight': 'bold', 'size': 25}
                 )

s_axs[0, 0].text(0, 0, 't (ms)',
                 horizontalalignment='center',
                 verticalalignment='center',
                 # rotation='vertical',
                 transform=s_axs[1, 3].transAxes,
                 fontdict={'weight': 'bold', 'size': 25}
                 )

nnmp.norm_color(s_img, 'tsp', 0.7)

# colorbar setup
mx = max(ims.get_array().max() for ims in s_img) * 0.7

for i in range(len(lvp)):
    axes = [s_axs[row[i], col[i]], s_axs[row[i], col[i] + 1]]
    for j in range(len(axes)):
        cbar = nnmp.colorbar_set(s_fig, axes[j], lvp[i], mx, s_img[i], 'tsp')

